# LLM配置
# 本地 Copilot 模式：先运行 `npm run copilot-adapter`，不需要外部 LLM_API_KEY。
LLM_PROVIDER=copilot
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_MODEL_NAME=gpt-5.5
COPILOT_MODEL=gpt-5.5

# 外部 OpenAI-compatible API 模式（可选）：
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL_NAME=qwen-plus

# ===== 图数据库配置 =====
# 默认使用本地 Neo4j 替代 Zep Cloud
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ===== ZEP记忆图谱配置（可选旧后端） =====
# 若设置 GRAPH_BACKEND=zep，则需要配置此项
# ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here

# Keep first runs cheap while validating concept/flow/features.
FLASK_DEBUG=False
OASIS_DEFAULT_MAX_ROUNDS=5
REPORT_AGENT_MAX_TOOL_CALLS=3
REPORT_AGENT_MAX_REFLECTION_ROUNDS=1
