# Local MiroFish setup using GitHub Copilot CLI as the LLM backend.
# Copy to .env, then run:
#   docker compose -f docker-compose.neo4j.yml up -d
#   npm run setup:all:venv
#   npm run dev:copilot

LLM_PROVIDER=copilot
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_MODEL_NAME=gpt-5.5
COPILOT_MODEL=gpt-5.5

GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

FLASK_DEBUG=False

# Keep first runs cheap while validating concept/flow/features.
OASIS_DEFAULT_MAX_ROUNDS=5
REPORT_AGENT_MAX_TOOL_CALLS=3
REPORT_AGENT_MAX_REFLECTION_ROUNDS=1
